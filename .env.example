# Smart Expense Insights Platform - example environment configuration
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# Every value below is read at startup by the fail-fast config validator
# (src/config/env.validation.ts). If a REQUIRED key is missing, empty, or
# whitespace-only, or has the wrong type, startup aborts and names the offending
# key(s) (Req 15.2, 15.3, 15.5).
#
# SECURITY (Req 15.4): secrets (JWT_SECRET, DATABASE_URL) are sourced from
# configuration, never hardcoded in source. Do NOT commit a real `.env`.
# On AWS these values come from SSM Parameter Store / Secrets Manager, injected
# as Lambda environment variables.

# Runtime environment: selects the bootstrap path.
#   local -> Express HTTP server via app.listen()
#   aws   -> exported Lambda handler (serverless-express)
# Allowed values: local | aws
RUNTIME_ENV=local

# Local HTTP port (used only when RUNTIME_ENV=local). Positive integer.
PORT=3000

# PostgreSQL connection string. Replace credentials for your environment.
DATABASE_URL=postgresql://user:password@localhost:5432/expense_dev

# JWT signing secret. MUST be replaced with a strong, unique secret in every
# real environment. Never commit the production value.
JWT_SECRET=change-me-in-production

# JWT lifetime in seconds. Design target is 3600 (1 hour) (Req 2.4).
JWT_EXPIRES_IN=3600

# Single configured platform time zone used for all date grouping (A3).
PLATFORM_TIMEZONE=UTC

# Log severity threshold. Allowed values: debug | info | warn | error
LOG_LEVEL=info

# Login lockout parameters (Req 2.7):
#   after LOGIN_MAX_ATTEMPTS failures within LOGIN_WINDOW_MINUTES,
#   lock the account for LOGIN_LOCKOUT_SECONDS.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_SECONDS=900

# OPTIONAL: comma-separated list of allowed cross-origin origins (CORS).
# When unset/blank, cross-origin access is DISABLED (safe default; never '*').
# When set, only the exact listed origins are allowed (credentials enabled).
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
# CORS_ORIGINS=
